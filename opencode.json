{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "ask",
    "bash": {
      "git *": "ask",
      "dotnet *": "ask",
      "docker *": "ask",
      "*": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Agente principal para desarrollo de software con restricciones estrictas",
      "permission": {
        "edit": "ask",
        "bash": {
          "git *": "ask",
          "dotnet *": "ask",
          "docker *": "ask",
          "*": "ask"
        }
      }
    }
  }
}
