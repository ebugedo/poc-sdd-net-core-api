# Variables de Entorno para GitHub Actions
# Copiar a .env.local y llenar con valores reales

# VPS Configuration
VPS_HOST=tu-vps-ip
VPS_USER=root
VPS_SSH_KEY=tu-ssh-key

# Database
DB_PASSWORD=tu-password-postgres

# GitHub (no modificar - se usa GITHUB_TOKEN)
# GITHUB_TOKEN se configura automáticamente
